# Copie para .env e substitua apenas no ambiente local. NÃO versionar .env.
NODE_ENV=development
APP_URL=http://localhost:3000
TZ=America/Sao_Paulo
DATABASE_URL=postgresql://financeiro:financeiro_dev_only@localhost:5432/financeiro?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=financeiro-documents
S3_ACCESS_KEY_ID=financeiro_dev
S3_SECRET_ACCESS_KEY=troque_em_producao
# Evolution API: endpoints dependem da versão homologada e NÃO devem ser adivinhados.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=
# Aceito temporariamente em paralelo durante a rotação autorizada do segredo.
EVOLUTION_WEBHOOK_SECRET_NEXT=
FINANCEIRO_WHATSAPP_JID=
PROPRIETARIA_WHATSAPP_JID=
# OpenAI para consultas da dona e extração de arquivos.
OPENAI_API_KEY=
OPENAI_QUERY_MODEL=
OPENAI_EXTRACTION_MODEL=
REMINDER_TIME_LOCAL=08:00
